{
    "_version": "1.65.0",

    "sap.app": {
        "id": "cti.widget",
        "type": "application",
        "title": "Real-Time CTI Widget",
        "description": "Real-time CTI widget for SAP Sales Cloud"
    },

    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {
        "rootView": {
            "viewName": "cti.widget.view.App",
            "type": "XML",
            "async": true,
            "id": "app"
        },

        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {}
            }
        }
    }
}